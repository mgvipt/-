# GMIdeas CRM — внутренний reverse proxy.
# На этом сервере 80/443 заняты системным nginx (он обслуживает другие проекты),
# поэтому Caddy здесь слушает обычный HTTP на внутреннем порту, а TLS и публичные
# 80/443 остаются за системным nginx, который проксирует сюда поддомен CRM.
:80 {
    encode gzip zstd

    # API, админка и статика Django -> бэкенд (gunicorn)
    handle /api/* {
        reverse_proxy web:8000
    }
    handle /admin/* {
        reverse_proxy web:8000
    }
    handle /static/* {
        reverse_proxy web:8000
    }
    # короткі посилання на оплату -> бекенд (редірект на LiqPay)
    handle /p/* {
        reverse_proxy web:8000
    }

    handle /d/* {
        reverse_proxy web:8000
    }

    # WebRTC веб-телефон: WebSocket до Asterisk (через форвардер на телефонному сервері)
    handle /pbx-ws* {
        rewrite * /ws
        reverse_proxy 46.225.71.162:9188
    }

    # всё остальное -> собранный SPA (React), с фолбэком на index.html
    handle {
        root * /srv
        @assets path /assets/*
        header @assets Cache-Control "public, max-age=31536000, immutable"
        @app not path /assets/*
        header @app Cache-Control "no-cache, must-revalidate"
        try_files {path} /index.html
        file_server
    }
}
