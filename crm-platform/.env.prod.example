# Скопируй в .env и заполни:  cp .env.prod.example .env
# Поддомен, на котором будет жить CRM (бесплатно, отдельный домен не нужен):
DOMAIN=crm.wallcovdec.com.ua

# Длинная случайная строка. Сгенерировать: openssl rand -hex 32
SECRET_KEY=ЗАМЕНИ_НА_СЛУЧАЙНУЮ_СТРОКУ

# База данных (придумай свой пароль):
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=ЗАМЕНИ_НА_ПАРОЛЬ
