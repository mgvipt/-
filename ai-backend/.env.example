# Скопіюйте у .env та заповніть
ANTHROPIC_API_KEY=sk-ant-...        # ключ Claude під цей застосунок (console.anthropic.com)
ANTHROPIC_MODEL=claude-opus-4-8     # краща якість розпізнавання; для економії — claude-sonnet-4-6
JWT_SECRET=                          # ТОЙ САМИЙ, що в cabinet-backend/.env (щоб приймати вхід кабінету)
PORT=8091   # 8080 на сервері зайнятий іншим застосунком; deploy.sh за замовчуванням бере 8091
# Транскрибація — локальний whisper.cpp (безкоштовно), шляхи вже задані в Docker:
# WHISPER_BIN=/opt/whisper/build/bin/whisper-cli
# WHISPER_MODEL=/opt/whisper/models/ggml-small.bin
# WHISPER_LANG=auto   # або uk / ru
