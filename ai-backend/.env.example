# Скопіюйте у .env та заповніть.
# ВАЖЛИВО: коментар має бути на ОКРЕМОМУ рядку. НЕ пишіть "# ..." у тому ж рядку,
# що й значення — Docker --env-file бере ВЕСЬ рядок після "=" як значення (разом із коментарем).

# Ключ Claude під цей застосунок (console.anthropic.com). Тільки сам ключ, без пробілів і коментарів.
ANTHROPIC_API_KEY=sk-ant-...

# Модель: claude-opus-4-8 (краща якість) або claude-sonnet-4-6 (дешевше)
ANTHROPIC_MODEL=claude-opus-4-8

# ТОЙ САМИЙ секрет, що в cabinet-backend/.env (щоб приймати вхід кабінету)
JWT_SECRET=

# Порт ШІ-бекенда. deploy.sh за замовчуванням бере 8099 (8080/8091 на сервері зайняті).
PORT=8099

# Транскрибація — локальний whisper.cpp (безкоштовно), шляхи вже задані в Docker:
# WHISPER_BIN=/opt/whisper/build/bin/whisper-cli
# WHISPER_MODEL=/opt/whisper/models/ggml-small.bin
# WHISPER_LANG=auto
