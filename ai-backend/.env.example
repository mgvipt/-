# Скопіюйте у .env та заповніть
ANTHROPIC_API_KEY=sk-ant-...        # окремий ключ Claude під цей застосунок (console.anthropic.com)
ANTHROPIC_MODEL=claude-sonnet-4-6   # або claude-opus-4-8 для кращої якості
API_TOKEN=придумайте-довгий-токен   # захист /process (застосунок шле Authorization: Bearer <цей токен>)
PORT=8080
# Транскрибація — локальний whisper.cpp (безкоштовно), шляхи вже задані в Docker:
# WHISPER_BIN=/opt/whisper/build/bin/whisper-cli
# WHISPER_MODEL=/opt/whisper/models/ggml-small.bin
# WHISPER_LANG=auto   # або uk / ru
