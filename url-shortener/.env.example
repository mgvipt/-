# Скопируйте этот файл в .env и отредактируйте значения

# Порт и адрес, на котором слушает Node.js процесс.
# Если используете Caddy/Nginx в качестве reverse-proxy — оставьте 127.0.0.1.
HOST=127.0.0.1
PORT=3000

# Публичный адрес сайта (используется для построения коротких URL в ответах API).
# Оставьте пустым, чтобы брать из заголовка Host.
PUBLIC_BASE_URL=https://your-domain.example

# Токен для доступа к админке и API создания/удаления ссылок.
# Сгенерируйте случайный: `openssl rand -hex 32`
ADMIN_TOKEN=change-me-to-a-long-random-string

# Путь к файлу SQLite (по умолчанию ./data/shortener.db).
# DB_PATH=/var/lib/url-shortener/shortener.db
