# Скопируйте в .env и заполните
JWT_SECRET=придумайте-длинную-случайную-строку   # подпись токенов входа
SIGNUP_CODE=                                       # ПУСТО = открытая регистрация (любой может зарегистрироваться). Впишите код, если хотите ограничить.
APP_URL=https://calc.wallcovdec.com.ua            # для ссылки восстановления пароля
PORT=8090

# Почта для восстановления пароля (если пусто — письма не шлются, ссылка пишется в лог контейнера).
# Пример для SMTP вашего домена или сервиса (Brevo/SendGrid/Gmail и т.п.):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Wallcov <no-reply@wallcovdec.com.ua>
