# --- Основное ---
PORT=8787
DATA_FILE=./data.json
PUBLIC_URL=https://api.твойдомен.ru
ALLOW_ORIGIN=*                 # или https://твой-фронтенд, для безопасности
ADMIN_TOKEN=придумай-длинный-секрет

# --- LLM (твой ключ, клиенты его не видят) ---
LLM_PROVIDER=claude            # claude | openai
LLM_MODEL=claude-sonnet-5      # claude-haiku-4-5 дешевле, больше маржа
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
LLM_MAX_TOKENS=700
# TEST_LLM=1                   # включить заглушку (без реального вызова) для теста

# --- Тарифы / маржа ---
CURRENCY=RUB
FREE_DAILY=10                  # бесплатных сообщений в день
PLAN_PRICE=399                 # цена подписки
PLAN_CAP=150                   # сообщений в период
PLAN_DAYS=30
CREDIT_PACKS=[{"id":"p100","credits":100,"price":199},{"id":"p300","credits":300,"price":499}]

# --- Платёжки (заполни те, что используешь) ---
# ЮKassa (РФ):
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=
# Stripe (мир):
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Telegram:
TELEGRAM_BOT_TOKEN=
TELEGRAM_PROVIDER_TOKEN=
